# ===== Database =====
DATABASE_URL=postgresql+asyncpg://flatout_user:flatout_pass@localhost:5432/flatout_db

# ===== App =====
APP_ENV=development
APP_NAME=FlatOut API
APP_VERSION=1.0.0

# ===== Auth =====
# Сгенерируй секрет: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== Misc =====
SQL_ECHO=false
